import matplotlib.pyplot as plt

# 1. Generate X values from 1 to 100
X = list(range(1, 101))

# 2. Define Y values where Y = X
Y = X

# 3. Plot Y = X on the graph
plt.plot(X, Y, label='Y = X', color='blue')

# 4. Add labels, grid, and title for clarity
plt.xlabel('X Axis')
plt.ylabel('Y Axis')
plt.title('Plot of Y = X')
plt.grid(True)
plt.legend()

# 5. Display the graph
plt.show()
