
from sympy import symbols, Implies, And, Not
from sympy.logic.inference import satisfiable

# Define propositional symbols
R, W, S = symbols('R W S')

# Knowledge Base
fact1 = Implies(R, W)
fact2 = Implies(W, S)
fact3 = R

KB = And(fact1, fact2, fact3)

# Negate the goal
not_G = Not(S)

# Check KB AND NOT G
formula = And(KB, not_G)
result = satisfiable(formula)

print("KB AND NOT G:", formula)
print("Result:", result)

if result is False:
    print("UNSATISFIABLE: The goal S is proved.")
else:
    print("SATISFIABLE: The goal is not proved.")
