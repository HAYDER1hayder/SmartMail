import matplotlib.pyplot as plt

# 1. إنشاء مساحة رسم ثلاثية الأبعاد
fig = plt.figure()
ax = fig.add_subplot(projection='3d')

# 2. تعريف البيانات (إضافة المحور Z كمثال)
X = list(range(1, 100))  # تقليل الرقم إلى 100 لوضوح الرسم
Y = [i**2 for i in X]
Z = [i**1.5 for i in X]  # البُعد الثالث الجديد

# 3. رسم الخط ثلاثي الأبعاد
ax.plot(X, Y, Z, label='Y = X^2', color='red')

# 4. تسمية المحاور والعنوان
ax.set_xlabel('Time')
ax.set_ylabel('Sample')
ax.set_zlabel('Z Axis')
ax.set_title('Observation 01 (3D)')

# 5. إظهار وسائل الإيضاح والرسم
ax.legend()
plt.show()
