
import random
import time
import matplotlib.pyplot as plt

# Selection Sort
def selection_sort(T):
    n = len(T)

    for i in range(n):
        min = i

        for j in range(i + 1, n):
            if T[j] < T[min]:
                min = j

        T[i], T[min] = T[min], T[i]


# Bubble Sort
def bubble_sort(T):
    n = len(T)

    for i in range(n):
        for j in range(n - i - 1):
            if T[j] > T[j + 1]:
                T[j], T[j + 1] = T[j + 1], T[j]


# Multiple Tests
sizes = [100, 200, 300, 400, 500]

selection = []
bubble = []

for n in sizes:

    T = [random.randint(1, 1000) for i in range(n)]

    # Selection Sort test
    A = T.copy()

    start = time.time()
    selection_sort(A)
    end = time.time()

    selection.append(end - start)

    # Bubble Sort test
    B = T.copy()

    start = time.time()
    bubble_sort(B)
    end = time.time()

    bubble.append(end - start)


# Display results
print("Size    Selection    Bubble")

for i in range(len(sizes)):
    print(sizes[i], "   ",
          selection[i], "   ",
          bubble[i])


# Draw graph
plt.plot(sizes, selection, label="Selection Sort", marker="o")
plt.plot(sizes, bubble, label="Bubble Sort", marker="o")

plt.xlabel("Number of elements")
plt.ylabel("Execution time")
plt.title("Sorting Algorithms Comparison")

plt.legend()
plt.grid()
plt.show()
